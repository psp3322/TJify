# 이 파일을 .env.local 로 복사해서 쓰세요 (.env.local 은 git에 올라가지 않습니다).
# 모두 선택입니다. 아무것도 없어도 붙여넣기와 노래방 번호 찾기는 됩니다. 자세한 설명은 docs/SETUP.md

# YouTube Data API v3 API 키: 공개 YouTube 재생목록 링크를 로그인 없이 가져오고 조회수를 보여 줍니다.
YOUTUBE_API_KEY=

# Anthropic API 키: 곡마다 난이도·대중성을 Claude로 추정합니다. (https://platform.claude.com)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5   # 요금을 줄이려면 claude-haiku-5-5
# AI_DAILY_SONG_LIMIT=3000          # 서버 인스턴스 하나가 하루에 Claude에 보내는 곡 수 상한

# ---- 계정 연결 (Spotify 좋아요, YouTube 좋아요, 내 플레이리스트) ----
# 쿠키 암호화 키 (32자 이상): node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# 앱 주소. Spotify·Google 콘솔에 등록한 리디렉션 URI의 앞부분과 같아야 합니다.
APP_URL=http://127.0.0.1:3000
# Spotify (https://developer.spotify.com/dashboard) - PKCE 방식이라 Client ID만 필요
SPOTIFY_CLIENT_ID=
# Google OAuth 웹 애플리케이션 클라이언트
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 그 밖의 선택 설정 ----
# KY_PROVIDER=manana        # off 로 두면 금영 검색을 끕니다
# TJ_CONCURRENCY=3          # 노래방 사이트로 보내는 동시 요청 수
# MANANA_CONCURRENCY=3
# KARAOKE_USER_AGENT=       # 노래방 사이트가 기본 User-Agent를 막을 때만
