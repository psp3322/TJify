# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)

# 쿠키 암호화 키 (32자 이상). 아래 명령으로 만들 수 있어요:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 앱 주소. Spotify·Google 콘솔에 등록하는 리디렉션 URI의 앞부분과 같아야 합니다.
# 로컬: http://127.0.0.1:3000   배포: https://your-app.vercel.app
APP_URL=http://127.0.0.1:3000

# Spotify (https://developer.spotify.com/dashboard) - PKCE 방식이라 Client ID만 필요
SPOTIFY_CLIENT_ID=

# Google / YouTube Data API v3 (https://console.cloud.google.com) - OAuth 웹 애플리케이션 클라이언트
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (선택) 금영 검색 끄기: off
# KY_PROVIDER=manana

# (선택) 노래방 사이트로 보내는 동시 요청 수 (기본 3)
# TJ_CONCURRENCY=3
# MANANA_CONCURRENCY=3

# (선택) 노래방 사이트가 기본 User-Agent를 막을 때만 바꾸세요
# KARAOKE_USER_AGENT=
