# 이 파일을 .env.local 로 복사해서 쓰세요 (.env.local 은 git에 올라가지 않습니다).
# 모두 선택입니다. 아무것도 없어도 붙여넣기와 노래방 번호 찾기는 됩니다. 자세한 설명은 docs/SETUP.md
# NEXT_PUBLIC_ 로 시작하는 값은 사이트 자바스크립트에 그대로 들어가는 공개 값입니다. 비밀 값은 넣지 마세요.

# 공개 YouTube 재생목록을 로그인 없이 가져오고 조회수를 보여 줍니다. Google Cloud에서 웹사이트 주소 제한을 걸어 두세요.
NEXT_PUBLIC_YOUTUBE_API_KEY=

# 계정 연결 (리디렉션 URI는 사이트 첫 화면 주소: 로컬은 http://127.0.0.1:3000/)
# Spotify (https://developer.spotify.com/dashboard) - PKCE 방식이라 Client ID만 필요
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
# Google OAuth 웹 애플리케이션 클라이언트 ID (보안 비밀번호는 쓰지 않습니다)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 하위 경로에 올릴 때만 (예: /TJify). GitHub Pages 워크플로는 자동으로 넣습니다
# NEXT_PUBLIC_BASE_PATH=

# 빌드할 때 TJ 인기차트를 받으러 가는 User-Agent. 막힐 때만 바꿉니다
# KARAOKE_USER_AGENT=
